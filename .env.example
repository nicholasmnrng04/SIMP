# npm run db:local:up membuat .env dengan kredensial acak untuk database lokal.
# Untuk PostgreSQL lain, isi URL sendiri pada .env; jangan commit rahasia.
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://simp_app:ISI_PASSWORD_LOKAL@127.0.0.1:55432/simp
DATABASE_SCHEMA=public
UPLOAD_DIR=./storage/uploads
PROJECT_TIMEZONE=Asia/Jakarta
LOG_LEVEL=info
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3001,http://localhost:3001
# Aktifkan true ketika aplikasi disajikan melalui HTTPS.
COOKIE_SECURE=false

# Hanya dibaca perintah db:bootstrap; tidak ada kata sandi bawaan.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
