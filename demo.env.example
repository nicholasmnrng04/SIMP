# Salin file ini sebagai .env.demo (diabaikan Git), lalu isi di komputer sendiri.
# Pakai Direct connection dari tombol Connect di proyek Supabase DEMO.
# Jangan gunakan Transaction pooler untuk migration.
DEMO_DATABASE_URL=postgresql://postgres:ISI_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DATABASE_SCHEMA=public
PROJECT_TIMEZONE=Asia/Jakarta
# Unduh sertifikat CA dari Supabase > Database > Settings > SSL Configuration.
# Simpan sebagai data/supabase-ca.crt (folder data diabaikan Git).
DEMO_DB_CA_FILE=./data/supabase-ca.crt
# Jika Direct tidak terjangkau karena IPv6, salin hanya hostname dari Connect > Session pooler.
# Contoh: aws-0-eu-central-1.pooler.supabase.com (jangan sertakan port, username, atau password).
# DEMO_DB_SESSION_HOST=

# Hanya diperlukan ketika menjalankan npm run db:demo:bootstrap.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
