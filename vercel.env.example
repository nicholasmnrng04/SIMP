# Contoh nama Environment Variables untuk Vercel. Jangan unggah file berisi nilai asli.
# Semua nilai diatur di Vercel > Project > Settings > Environment Variables.
# Pakai Transaction pooler Supabase (port 6543), bukan URL Direct IPv6.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD_TERKODE@HOST_SESSION_POOLER:6543/postgres?sslmode=require
DATABASE_SCHEMA=public
# Base64 dari data/supabase-ca.crt. Lihat docs/deploy-demo.md untuk perintah aman.
DATABASE_CA_BASE64=BASE64_SERTIFIKAT_CA
PROJECT_TIMEZONE=Asia/Jakarta
APP_ORIGINS=https://NAMA_PROYEK.vercel.app
COOKIE_SECURE=true
LOG_LEVEL=info

# URL proyek dan secret key Supabase dari proyek yang sama dengan DATABASE_URL.
# Secret key hanya digunakan di server; jangan memakai awalan VITE_.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=SECRET_KEY_SERVER_SIDE
SUPABASE_STORAGE_BUCKET=simp-report-photos
